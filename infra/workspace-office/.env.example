# Copy to .env on the VPS and replace every example value with a unique secret.
NEXTCLOUD_DOMAIN=docs.agricapital.ci
ONLYOFFICE_DOMAIN=office.agricapital.ci

NEXTCLOUD_ADMIN_USER=agricapital-admin
NEXTCLOUD_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
NEXTCLOUD_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
ONLYOFFICE_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# In Vercel, set VITE_OFFICE_SUITE_URL=https://docs.agricapital.ci
